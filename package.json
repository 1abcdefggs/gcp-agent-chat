{
  "name": "gcp-agent-chat",
  "displayName": "GCP Agent Chat - Google Cloud Vertex AI & Gemini Assistant",
  "description": "Native IDE sidebar chat assistant powered by Google Cloud Vertex AI (Gemini 3.7-flash) with zero-CLI IDE login, autonomous tool execution, and session management.",
  "version": "0.5.0",
  "publisher": "1abcdefggs",
  "author": {
    "name": "1abcdefggs",
    "url": "https://github.com/1abcdefggs"
  },
  "license": "MIT",
  "homepage": "https://github.com/1abcdefggs/gcp-agent-chat#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/1abcdefggs/gcp-agent-chat.git"
  },
  "bugs": {
    "url": "https://github.com/1abcdefggs/gcp-agent-chat/issues"
  },
  "galleryBanner": {
    "color": "#0d0d12",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "gcp",
    "google cloud",
    "gemini",
    "vertex ai",
    "agent",
    "chat",
    "ai assistant",
    "antigravity",
    "coding assistant",
    "gemini 3.7",
    "developer tools",
    "copilot",
    "genai",
    "llm",
    "productivity"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-platform-sidebar",
          "title": "Google Cloud Agent",
          "icon": "asset/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "agent-platform-panel",
          "title": "Google Cloud Agent",
          "icon": "asset/icon.svg"
        }
      ]
    },
    "views": {
      "agent-platform-sidebar": [
        {
          "id": "agent-platform-chat-view",
          "name": "Gemini Agent Chat",
          "type": "webview",
          "icon": "asset/icon.svg"
        }
      ],
      "agent-platform-panel": [
        {
          "id": "agent-platform-chat-view-panel",
          "name": "Gemini Agent Chat",
          "type": "webview",
          "icon": "asset/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "agent-platform.openChat",
        "title": "Google Cloud Agent: Open Chat"
      },
      {
        "command": "agent-platform.askAboutCode",
        "title": "Google Cloud Agent: Ask about this code"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "agent-platform.askAboutCode",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Google Cloud Agent Platform",
      "properties": {
        "agentPlatform.projectId": {
          "order": 1,
          "type": "string",
          "default": "",
          "description": "Google Cloud Project ID (e.g. 'my-gcp-project-123'). If left empty, GOOGLE_CLOUD_PROJECT environment variable will be used."
        },
        "agentPlatform.location": {
          "order": 2,
          "type": "string",
          "default": "global",
          "description": "Google Cloud Region / Location (e.g. 'global', 'us-central1')."
        },
        "agentPlatform.authMode": {
          "order": 3,
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "ide",
            "gcloud",
            "serviceAccount"
          ],
          "enumDescriptions": [
            "Auto (Use IDE Google login if available, fallback to gcloud ADC)",
            "Antigravity IDE (Always use IDE Google Account)",
            "gcloud ADC (Use separate Google Cloud account authenticated via gcloud)",
            "Service Account (Use GOOGLE_APPLICATION_CREDENTIALS key file)"
          ],
          "description": "Authentication method for Google Cloud Vertex AI."
        },
        "agentPlatform.model": {
          "order": 4,
          "type": "string",
          "default": "gemini-3.7-flash",
          "enum": [
            "gemini-3.7-flash",
            "gemini-3.6-flash",
            "gemini-2.5-flash",
            "gemini-2.5-pro"
          ],
          "enumDescriptions": [
            "gemini-3.7-flash (Fast, cost-effective, multimodal)",
            "gemini-3.6-flash",
            "gemini-2.5-flash",
            "gemini-2.5-pro (Deep reasoning and complex task execution)"
          ],
          "description": "Default Gemini model for Agent conversations."
        },
        "agentPlatform.language": {
          "order": 5,
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "ar",
            "zh",
            "nl",
            "fr",
            "de",
            "hi",
            "it",
            "ja",
            "ko",
            "pt",
            "ru",
            "es"
          ],
          "enumDescriptions": [
            "Auto Detect (Follow input language)",
            "English (English)",
            "Arabic (العربية)",
            "Chinese (中文)",
            "Dutch (Nederlands)",
            "French (Français)",
            "German (Deutsch)",
            "Hindi (हिन्दी)",
            "Italian (Italiano)",
            "Japanese (日本語)",
            "Korean (한국어)",
            "Portuguese (Português)",
            "Russian (Русский)",
            "Spanish (Español)"
          ],
          "description": "Default target language for Agent responses."
        },
        "agentPlatform.monthlyBudgetLimit": {
          "order": 6,
          "type": "number",
          "default": 10,
          "description": "Monthly budget limit ($) for Gemini API token usage. Requests will be safely blocked when exceeded."
        },
        "agentPlatform.sessionStorageLocation": {
          "order": 7,
          "type": "string",
          "default": "global",
          "enum": [
            "global",
            "workspace"
          ],
          "enumDescriptions": [
            "Global AppData directory (Zero repository pollution and maximum privacy)",
            "Current workspace directory (.agents/sessions/)"
          ],
          "description": "Location where chat session logs are automatically stored."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:version": "node -e \"const v=require('./package.json').version; if(!/^\\d+\\.\\d+\\.\\d+$/.test(v)){console.error('Invalid semver format:', v); process.exit(1);}; console.log('Version format valid:', v);\""
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0"
  }
}
