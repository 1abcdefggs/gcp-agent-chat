# Google Cloud Agent Platform Configuration

# [Required] Your Google Cloud Project ID (e.g., "my-gcp-project-123")
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID

# [Optional] Google Cloud Location / Region (Default: "global" or "us-central1")
GOOGLE_CLOUD_LOCATION=global

# [Optional] Enable Enterprise Vertex AI backend routing (Default: "True")
GOOGLE_GENAI_USE_ENTERPRISE=True
